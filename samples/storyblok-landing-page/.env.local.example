# Storyblok space's Content Delivery API token (Preview token for draft content).
# Space Settings -> Access Tokens in the Storyblok UI.
NEXT_PUBLIC_STORYBLOK_CONTENT_TOKEN=your-storyblok-preview-token

# "draft" while developing so unpublished changes show up in the Visual Editor,
# "published" for a production build.
NEXT_PUBLIC_STORYBLOK_VERSION=draft

# Storyblok API region. Use "eu" (default) unless your space was created in the US, China or Australia region.
# See https://www.storyblok.com/docs/api/content-delivery/v2#topics/regions
NEXT_PUBLIC_STORYBLOK_REGION=eu
